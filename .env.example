# Semua variabel dibaca saat build. Mengubahnya di Vercel butuh Redeploy.

# mock (default): data demo di localStorage browser, tanpa backend.
# real: panggilan ke VITE_API_URL (backend belum dibuat; lihat docs rencana backend).
VITE_API_MODE=mock
# VITE_API_URL=https://api.contoh.id

# Demo portofolio: pengalih usaha contoh tampil dan ?profil=<id> berlaku.
# Situs klien: false, dan isi VITE_PROFIL dengan profil klien.
VITE_MODE_DEMO=true
# Profil yang tampil pertama kali: teh-senja | kopi-lintas | dapur-mie-rasa
VITE_PROFIL=teh-senja
